# Internal Logic of BGR to RGB Conversion
# (Logic executed inside cv2.cvtColor)
def internal_convert_bgr_to_rgb(image_array):
    height, width, _ = image_array.shape
    rgb_image = create_empty_array(height, width, 3)

    for y in range(height):
        for x in range(width):
            # 1. Access BGR channels from memory
            blue  = image_array[y, x, 0]
            green = image_array[y, x, 1]
            red   = image_array[y, x, 2]

            # 2. Swap positions for RGB output
            rgb_image[y, x, 0] = red
            rgb_image[y, x, 1] = green
            rgb_image[y, x, 2] = blue

    return rgb_image

#Internal Logic of Image Construction
# (Logic executed inside Image.fromarray)
def internal_fromarray(rgb_image):   # Input comes directly from Figure 3.2.1
    # 1. Analyze Input Structure
    height, width, channels = rgb_image.shape
    
    # 2. Allocate New Image Object
    pil_img_object = ImageObject()
    pil_img_object.width = width
    pil_img_object.height = height
    
    # 3. Determine Mode based on depth (3 channels = RGB)
    if channels == 3:
        pil_img_object.mode = "RGB"
    
    # 4. Bind Pixel Data (Conceptual Copy)
    # The function reads the grid of numbers from the previous step
    # and stores them as the internal bitmap for the object.
    pil_img_object.bitmap_buffer = copy_memory(rgb_image)
    
    return pil_img_object

# AInternal Logic of Bilinear Interpolation
# (Logic executed inside transforms.Resize)
def internal_bilinear_resize(pil_img_object, target_h, target_w):
    # Input 'pil_img_object' comes from the previous step Figure 3.2.2
    original_h = pil_img_object.height
    original_w = pil_img_object.width
    
    # Create empty array for the new 224x224 image
    resized_image = create_empty_array(target_h, target_w)
    
    scale_x = original_w / target_w
    scale_y = original_h / target_h

    for y_out in range(target_h):
        for x_out in range(target_w):
            # 1. Map output pixel to input fractional coordinate
            x_in = x_out * scale_x
            y_in = y_out * scale_y

            # 2. Identify 4 nearest integer neighbors
            x_floor = floor(x_in);  x_ceil = x_floor + 1
            y_floor = floor(y_in);  y_ceil = y_floor + 1

            # 3. Calculate interpolation weights
            dx = x_in - x_floor
            dy = y_in - y_floor

            # 4. Compute weighted average of the 4 neighbors
            # Access pixel data from the PIL object's internal buffer
            top_px = (1-dx) * pil_img_object.get_pixel(x_floor, y_floor) + \
                     (dx)   * pil_img_object.get_pixel(x_ceil,  y_floor)
            btm_px = (1-dx) * pil_img_object.get_pixel(x_floor, y_ceil)  + \
                     (dx)   * pil_img_object.get_pixel(x_ceil,  y_ceil)
            
            # Final interpolated value
            resized_image[y_out, x_out] = (1-dy) * top_px + (dy) * btm_px

    return resized_image

# Internal Logic of Tensor Conversion
# (Logic executed inside transforms.ToTensor)
def internal_to_tensor(resized_image):
    # Input 'resized_image' comes from Figure 3.2.4
    height = resized_image.height
    width  = resized_image.width
    
    # 1. Allocate Tensor in Channel-First format (C, H, W)
    # Note: Structure changes from (224, 224, 3) to (3, 224, 224)
    image_tensor = create_float_tensor(3, height, width)
    
    # 2. Iterate and Transpose
    for y in range(height):
        for x in range(width):
            # Get raw pixel tuple (r, g, b) in range 0-255
            r, g, b = resized_image.get_pixel(x, y)
            
            # 3. Scale values to [0.0, 1.0] range
            # Store Red in channel 0, Green in 1, Blue in 2
            image_tensor[0, y, x] = r / 255.0
            image_tensor[1, y, x] = g / 255.0
            image_tensor[2, y, x] = b / 255.0
            
    return image_tensor

# Internal Logic of Normalization
# (Logic executed inside transforms.Normalize)
def internal_normalize(image_tensor, mean_vals, std_vals):
    # Input 'image_tensor' comes directly from Figure 3.2.5
    # It is already in (C, H, W) format and scaled to 0.0-1.0
    
    # Create empty tensor for the final output
    normalized_tensor = create_empty_like(image_tensor)

    # 1. Iterate over each color channel (Red=0, Green=1, Blue=2)
    for c in range(3): 
        channel_mean = mean_vals[c]
        channel_std  = std_vals[c]
        
        # 2. Apply Z-score formula to every pixel in the channel
        for y in range(224):
            for x in range(224):
                # Access the pixel value from the tensor
                original_val = image_tensor[c, y, x]
                
                # Subtract mean and divide by standard deviation
                normalized_tensor[c, y, x] = (original_val - channel_mean) / channel_std
                
    return normalized_tensor

# Internal Logic of Batch Formatting
# (Logic executed inside tensor.unsqueeze)
def internal_unsqueeze(normalized_tensor):
    # Input 'normalized_tensor' comes from Figure 3.2.3b
    # Current shape is (channels, height, width) -> (3, 224, 224)
    c, h, w = normalized_tensor.shape
    
    # 1. Define new Batch Size (N=1)
    batch_size = 1
    
    # 2. Allocate 4D Tensor structure
    # New shape becomes (Batch, Channels, Height, Width) -> (1, 3, 224, 224)
    batch_tensor = create_empty_tensor(batch_size, c, h, w)
    
    # 3. Embed the single image into the batch container
    # (Conceptually placing the image at index 0 of the batch)
    batch_tensor[0] = normalized_tensor
    
    return batch_tensor